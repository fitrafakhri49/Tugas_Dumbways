<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />

    <style>
      section {
        padding: 150px;
      }
    </style>
    <title>Home</title>
  </head>
  <body>
    <!-- navbar -->
    <nav
      class="navbar navbar-expand-md fixed-top"
      style="background-color: white"
    >
      <div class="container-lg">
        <a href="#intro" class="navbar-brand">
          <span class="fw-bold">
            <i class="me-2 bi bi-badge-tm"></i>Fakhri Fitra Perdana
          </span></a
        >
        <!-- toggle button for small screen-->
        <button
          class="navbar-toggler"
          type="button"
          data-bs-toggle="collapse"
          data-bs-target="#main-nav"
        >
          <span class="navbar-toggler-icon"></span>
        </button>

        <div
          class="collapse navbar-collapse justify-content-end align-items-start"
          id="main-nav"
        >
          <ul class="navbar-nav gap-5">
            <li class="nav-item">
              <a class="nav-link fs-5" href="#tech-stack">Tech Stack</a>
            </li>
            <li class="nav-item">
              <a class="nav-link fs-5" href="#experience">Experience</a>
            </li>
            <li class="nav-item">
              <a class="nav-link fs-5" href="#myproject">Project</a>
            </li>
            <li class="nav-item">
              <a href="" class="btn btn-success fs-5">Call Me </a>
            </li>
          </ul>
        </div>
      </div>
    </nav>
    <!-- nav section  -->
    <section id="intro">
      <div class="container-lg d-flex">
        <div class="row justify-content-start align-items-center">
          <div class="col-12 col-md-6 text-center text-md-start">
            <img
              class="img-fluid rounded shadow"
              src="../assets/images/unnamed.jpg"
              alt="photo profile"
              style="max-width: 100%"
            />
          </div>
          <!-- image container -->
          <div class="col-12 col-md-6 text-center text-md-start py-5">
            <h1 class="display-1 fs-1 fw-bold">Hi, I'm Fakhri</h1>
            <p class="lead fs-1">Full-Stack Developer</p>
            <p class="fs-2">
              Lorem ipsum dolor sit amet consectetur adipisicing elit.
              Distinctio voluptates omnis deserunt ipsum pariatur, in sequi
              dolorum accusantium corrupti nulla!
            </p>
            <span class="fs-4 d-block"
              ><i class="bi bi-geo-alt-fill"></i> Ciamis, Muktisari,
              Indonesia</span
            >
            <span>
              <a href="" class="btn btn-success fs-5 my-4">Call Me </a></span
            >
          </div>
          <!-- text container  -->
        </div>
      </div>
      <!-- container card  -->
    </section>
    <!-- intro section  -->

    <section id="tech-stack">
      <div class="container">
        <div class="text-start justify-content-start align-items-center">
          <h1 class="display-4 fw-bold">Tech Stack - Tools I Use Everyday</h1>
        </div>
        <!-- container text  -->

        <div
          class="row text-center justify-content-around align-items-center py-5"
        >
          <div class="col-5 col-md-2 py-5">
            <img
              class="img-fluid rounded shadow my-5"
              src="../assets/images/html.png"
              alt="photo profile"
            />
            <p class="display-5 fs-2">HTML</p>
          </div>
          <div class="col-5 col-md-2">
            <img
              class="img-fluid rounded shadow my-5"
              src="../assets/images/css.png"
              alt="photo profile"
            />
            <p class="display-5 fs-2">CSS</p>
          </div>
          <div class="col-5 col-md-2">
            <img
              class="img-fluid rounded shadow my-5"
              src="../assets/images/javascript.png"
              alt="photo profile"
            />
            <p class="display-5 fs-2">Javascript</p>
          </div>

          <div class="col-5 col-md-2">
            <img
              class="img-fluid rounded shadow my-5"
              src="../assets/images/postgre.png"
              alt="photo profile"
            />
            <p class="display-5 fs-2">Postgre</p>
          </div>
        </div>
        <!-- container picture -->
      </div>
      <!-- container tech stack  -->
    </section>
    <!-- tech stack section  -->
    <section id="experience">
          
      <div class="container-lg">
        <div class="text-start justify-content-center align-items-center">
          <span class="fs-1 fw-bold">
            <a href="/loginExperience" class="">
              <i class="bi bi-plus-square-fill fs-1 me-4"></i></a
            >My Experience :
          </span>
          {{#each experiences}}
          <div class="row justify-content-start">
            <div
              class="col-12 col-md-1 text-center text-md-start"
              style="width: 8rem"
            >
              <img
                class="img rounded shadow mt-5 w-50"
                src="../assets/uploads/{{image}}"
                alt="photo profile"
              />
            </div>
            <!-- image container -->
            <div class="col-12 text-start text-md-start py-5">
              <h1 class="display-1 fs-1 fw-bold"><i class="bi bi-circle-fill fs-5"></i> {{experience}}</h1>
              <p class="lead fs-1"> <i class="bi bi-geo-alt-fill fs-5"></i> {{location}}</p>
              <p>{{description}}</p>
              <span class="fs-4 d-block"
                >{{technology}}</span
              >
               <form action="/experience/delete/{{this.id}}" method="POST" >
                  <button type="submit" class="btn btn-danger btn-sm m-3">Delete</button>
                </form>
            </div>
            </div>
                      {{/each}}
            <!-- text container  -->
          </div>
        </div>
      </div>

    </section>
    <!-- experience section  -->

    <section id="myproject">
      <div class="container">
        <div class="text-start justify-content-center align-items">
          <span class="fs-1 fw-bold">
            <a href="/loginProject" class="">
              <i class="bi bi-plus-square-fill fs-1 me-4"></i></a
            >My Project :
          </span>
          {{#each projects}}
          <div class="row justify-content-start">
            <div class="col-12 col-md-6 text-center-text-md-start">
              <div class="card mt-5" style="width: 25rem">
                <img
                  src="../assets/uploads/{{image}}"
                  class="card-img-top"
                  alt="..."
                  style="max-width: 100%"
                />
                <div class="card-body">
                  <h5 class="card-title">{{title}}</h5>
                  <p class="card-text">
                    {{description}}
                  </p>
                  <p>Technology: {{technologies}}</p>
                </div>
                <form action="/project/delete/{{this.id}}" method="POST" >
                  <button type="submit" class="btn btn-danger btn-sm m-3">Delete</button>
                </form>
              </div>
            </div>
            {{/each}}
          </div>
        </div>
      </div>
    </section>
    <!-- project section  -->

    
    <script
      src="https://cdn.jsdelivr.net/npm/@popperjs/core@2.11.8/dist/umd/popper.min.js"
      integrity="sha384-I7E8VVD/ismYTF4hNIPjVp/Zjvgyol6VFvRkX/vR+Vc4jQkC+hVqc2pM8ODewa9r"
      crossorigin="anonymous"
    ></script>
    <script
      src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/js/bootstrap.min.js"
      integrity="sha384-G/EV+4j2dNv+tEPo3++6LCgdCROaejBqfUeNjuKAiuXbjrxilcCdDz6ZAVfHWe1Y"
      crossorigin="anonymous"
    ></script>
  </body>
</html>
