<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>AddExperience</title>
    <link
      href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.8/dist/css/bootstrap.min.css"
      rel="stylesheet"
      integrity="sha384-sRIl4kxILFvY47J16cr9ZwB07vP4J8+LH7qKQnuqkuIAvNWLzeN8tE5YBujZqJLB"
      crossorigin="anonymous"
    />
    <link rel="stylesheet" href="../assets/styles/addProject.css" />
    <link
      rel="stylesheet"
      href="https://cdn.jsdelivr.net/npm/bootstrap-icons@1.13.1/font/bootstrap-icons.min.css"
    />
  </head>
  <body>
    <h1 class="display-1 text-center fw-bold">Add Experience</h1>
    <div class="row justify-content-center my-5">
      <div class="col-lg-6">
        <form action="/addExperience" method="post" enctype="multipart/form-data">
          <label for="experience" class="form-label">Experience:</label>
          <div class="mb-4 input-group">
            <span class="input-group-text">
              <i class="bi bi-kanban"></i>
            </span>
            <input
              type="text"
              class="form-control"
              id="text"
              placeholder="Dumbways Web App"
              name="experience"
            />
          </div>
          <!-- Experinece Form  -->
          <label for="location" class="form-label">Location :</label>
          <div class="mb-4 input-group">
            <span class="input-group-text">
              <i class="bi bi-geo-alt-fill"></i>
            </span>
            <input
              type="text"
              class="form-control"
              id="location"
              placeholder="Jakarta"
              name="location"
            />
          </div>
          <!-- location form  -->
          <div class="form-floating mb-4 mt-5">
            <textarea
              name="description"
              id="description"
              cols="30"
              rows="10"
              class="form-control"
              style="height: 100px"
            ></textarea>
            <label for="query" class="form-label">Description ...</label>
          </div>
          <!-- description form -->
          <label for="technology" class="form-label">Technology: </label>
          <div
            class="btn-group m-4"
            role="group"
            aria-label="Basic checkbox toggle button group"
          >
            <input
              type="checkbox"
              class="btn-check"
              id="btncheck1"
              autocomplete="off"
              name="tech[]"
              value="HTML"
            />
            <label class="btn btn-outline-primary" for="btncheck1">HTML</label>

            <input
              type="checkbox"
              class="btn-check"
              id="btncheck2"
              autocomplete="off"
              name="tech[]"
              value="CSS"
            />
            <label class="btn btn-outline-primary" for="btncheck2">CSS</label>

            <input
              type="checkbox"
              class="btn-check"
              id="btncheck3"
              autocomplete="off"
              name="tech[]"
              value="Javascript"
            />
            <label class="btn btn-outline-primary" for="btncheck3"
              >Javascript</label
            >
           
          </div>

          <div>
            <label for="formFileLg" class="form-label">Image</label>
            <input
              class="form-control form-control-lg"
              id="formFileLg"
              type="file"
              name="image"
            />
          </div>
          <div class="my-4 text-center">
            <button type="submit" class="btn btn-primary">Submit</button>
          </div>
        </form>
      </div>
    </div>
  </body>
</html>
